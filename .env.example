NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_RPC_WS_URL=wss://api.devnet.solana.com
# Server processes use separate endpoints so browser traffic cannot exhaust the
# authority process quota. Configure both to the same Devnet provider project.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_WS_URL=wss://api.devnet.solana.com
NEXT_PUBLIC_BATTLE_SERVER_URL=ws://localhost:3001
BATTLE_SERVER_PORT=3001
BATTLE_SERVER_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
CAPTURE_AUTHORITY_SECRET_KEY_BASE64=your-64-byte-keypair-as-base64
MATCH_RESOLVER_SECRET_KEY_BASE64=your-64-byte-keypair-as-base64
WQ_CAPTURE_AUTHORITY_KEYPAIR_PATH=.wildquest-keys/capture-authority.json
WQ_MATCH_RESOLVER_KEYPAIR_PATH=.wildquest-keys/match-resolver.json
ENABLE_GENERATE_ANIMAL=false
NEXT_PUBLIC_ENABLE_GENERATE_ANIMAL=false
GENERATE_ANIMAL_ADMIN_ADDRESSES=
GENERATE_ANIMAL_CHALLENGE_SECRET=
