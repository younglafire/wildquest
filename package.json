{
  "name": "wildquest",
  "scripts": {
    "anchor-build": "anchor build --ignore-keys",
    "anchor-test": "anchor build --ignore-keys && cargo test",
    "battle-server": "tsx --env-file=.env.local scripts/battle-realtime-server.ts",
    "battle:balance": "tsx --env-file=.env.local scripts/simulate-battle-balance.ts",
    "build": "next build",
    "ci": "npm run build && npm run lint && npm run format:check",
    "codama:js": "codama run js",
    "dev": "concurrently --kill-others --names web,battle --prefix-colors cyan,green \"npm:dev:web\" \"npm:battle-server\"",
    "dev:web": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "setup": "npm run anchor-build && npm run codama:js",
    "setup:pk-config": "tsx --env-file=.env.local scripts/setup-pk-demo-roster.ts --configs-only",
    "setup:pk-demo": "tsx --env-file=.env.local scripts/setup-pk-demo-roster.ts",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "test:pk-devnet": "tsx --env-file=.env.local scripts/pk-devnet-battle.ts",
    "reset:pk-devnet": "tsx --env-file=.env.local scripts/reset-pk-devnet.ts",
    "start": "next start",
    "test": "vitest run",
    "test:devnet": "tsx --env-file=.env.local scripts/wq-devnet-loop.ts",
    "test:watch": "vitest"
  },
  "description": "WildQuest Solana dApp with an Anchor program and generated client",
  "keywords": [
    "anchor",
    "kit",
    "nextjs",
    "react",
    "solana-kit",
    "tailwind",
    "typescript"
  ],
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@solana/kit": "^6.3.0",
    "@solana/kit-client-rpc": "^0.7.0",
    "@solana/kit-plugin-rpc": "^0.7.0",
    "@solana/wallet-standard-features": "^1.3.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@wallet-standard/app": "^1.1.0",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/features": "^1.1.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "sonner": "^2.0.7",
    "swr": "^2.2.0",
    "three": "^0.185.1",
    "ws": "^8.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.3",
    "@codama/renderers-js": "1.7.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "codama": "1.10.0",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
